# Use localhost when running API on your machine (uvicorn, pytest against real PG)
DATABASE_URL=postgresql://paybuddy:paybuddy@localhost:5432/paybuddy

# Use host "db" only inside Docker Compose (set automatically in docker-compose.yml)
# DATABASE_URL=postgresql://paybuddy:paybuddy@db:5432/paybuddy

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
DEBUG=false
